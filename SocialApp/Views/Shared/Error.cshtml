@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="auth-wrap">
    <div class="card auth-card error-card">
        <div class="error-badge">
            <span class="error-code nums">@(Model.StatusCode.HasValue ? Model.StatusCode.Value.ToString() : "Error")</span>
        </div>

        <h1 class="error-title">@Model.Title</h1>
        <p class="error-text">@Model.Message</p>

        @if (Model.ShowRequestId)
        {
            <div class="dev-note">
                <span class="dev-note-tag">Diagnostics</span>
                <strong>Request ID</strong>
                <code>@Model.RequestId</code>
            </div>
        }

        <div class="error-actions">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">
                Return to Home
            </a>
            <a class="btn btn-ghost" asp-controller="Explore" asp-action="Index">
                Explore Feed
            </a>
        </div>
    </div>
</div>
